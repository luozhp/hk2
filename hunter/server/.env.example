# ==============================================
# Hunter B2B 寻客系统 · 正式版环境配置模板
# 复制为 server/.env 后填写真实值（.env 不入库）
# ==============================================

# ---------- 服务与安全 ----------
# 后端端口
PORT=3000
# JWT 签名密钥（生产必须改为足够长的随机串，如：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
# JWT 有效期（默认 7 天）
JWT_EXPIRES_IN=7d
# 新用户/重置密码的默认初始密码（首次登录后请立即修改）
DEFAULT_USER_PASSWORD=Hunter@123

# ---------- 数据库 ----------
# SQLite 自动备份保留份数（默认 7 份，位于 server/data/backups/）
DB_BACKUP_KEEP=7

# ---------- 线索采集（Discover 模块）----------
# 数据源类型：mock（默认，模拟数据）| google（Google Custom Search JSON API）| serp（SerpAPI）
DISCOVER_PROVIDER=mock
# Google Custom Search JSON API（provider=google 时必填）
# 申请地址：https://programmablesearchengine.google.com/ 与 https://console.cloud.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# SerpAPI（provider=serp 时必填）：https://serpapi.com/
SERP_API_KEY=

# ---------- 海关数据免费接口（Customs 模块）----------
# 美国人口普查局国际贸易 API 免费 Key（用于「海关数据」页按 HS 编码在线查询美国进出口统计）
# 免费申请（秒级）：https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ---------- 邮件发送（MailCenter 模块）----------
# 通道类型：mock（默认，模拟发送）| smtp（真实发送）
MAIL_PROVIDER=mock
# 发件人地址（需与 SMTP 账号/域名 SPF 一致）
MAIL_FROM=sales@smileiceqi.com
# SMTP 凭证（provider=smtp 时必填，可用 Amazon SES / SendGrid / 企业邮箱）
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# 单账号每日发送上限（防垃圾信）
MAIL_DAILY_LIMIT=50
# 打开追踪像素公网地址（如 https://your-server.com）。配置后真实发送的邮件会自动附加 1x1 追踪图片，
# 收件人打开邮件即把发送记录回写为「已打开」。留空不启用。
MAIL_TRACK_BASE_URL=

# ---------- 邮件接收（MailCenter 客户回信）----------
# IMAP 收件箱配置：填齐后「同步收件箱」自动拉取客户回信并归集到客户；留空时使用模拟回信演示
# 常见：企业邮箱（如阿里/腾讯企业邮）host 为 imap.域名.com:993；Gmail 需开启应用专用密码
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASS=
# 是否使用 SSL（默认 true）
MAIL_IMAP_SSL=true
