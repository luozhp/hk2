# 真实数据源配置（Discover 模块）
# 不配置或 DISCOVER_PROVIDER=mock 时使用模拟数据，保证原型可演示

# 数据源类型：mock（默认）| google（Google Custom Search JSON API）| serp（SerpAPI）
DISCOVER_PROVIDER=mock

# Google Custom Search JSON API（provider=google 时必填）
# 申请地址：https://programmablesearchengine.google.com/ 与 https://console.cloud.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# SerpAPI（provider=serp 时必填）
# 申请地址：https://serpapi.com/
SERP_API_KEY=

# 真实邮件通道（MailCenter 模块）
# 数据源类型：mock（默认）| smtp
MAIL_PROVIDER=mock
MAIL_FROM=sales@smileiceqi.com
# SMTP 凭证（provider=smtp 时必填，可用任意 SMTP 服务，如 Amazon SES / SendGrid / 企业邮箱）
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
